{
  "rules": {
    ".read": false,
    ".write": false,

    "admins": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": false
      }
    },

    "settings": {
      ".read": true,
      ".write": "auth != null && root.child('admins').child(auth.uid).val() === true",
      ".validate": "newData.hasChildren(['startTime', 'endTime', 'slotStep', 'workingDays'])",
      "studioName":     { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 60" },
      "startTime":      { ".validate": "newData.isString() && newData.val().matches(/^([01][0-9]|2[0-3]):[0-5][0-9]$/)" },
      "endTime":        { ".validate": "newData.isString() && newData.val().matches(/^([01][0-9]|2[0-3]):[0-5][0-9]$/)" },
      "slotStep":       { ".validate": "newData.isNumber() && newData.val() >= 30 && newData.val() <= 240 && newData.val() % 30 === 0" },
      "leadMinutes":    { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 10080" },
      "maxAdvanceDays": { ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 365" },
      "whatsapp":       { ".validate": "newData.isString() && newData.val().length <= 20" },
      "workingDays": {
        "$i": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 6" }
      },
      "$other": { ".validate": false }
    },

    "services": {
      ".read": true,
      ".write": "auth != null && root.child('admins').child(auth.uid).val() === true",
      "$sid": {
        ".validate": "newData.hasChildren(['name', 'price', 'duration'])",
        "name":     { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 60" },
        "price":    { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100000" },
        "duration": { ".validate": "newData.isNumber() && newData.val() >= 30 && newData.val() <= 480 && newData.val() % 30 === 0" },
        "$other":   { ".validate": false }
      }
    },

    "busy": {
      ".read": true,
      ".write": false
    },

    "users": {
      ".read": "auth != null && root.child('admins').child(auth.uid).val() === true",
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid",
        ".validate": "newData.hasChildren(['name', 'email'])",
        "name":      { ".validate": "newData.isString() && newData.val().length >= 2 && newData.val().length <= 60" },
        "phone":     { ".validate": "newData.isString() && newData.val().length <= 20" },
        "email":     { ".validate": "newData.isString() && newData.val().length <= 120" },
        "createdAt": { ".validate": "newData.isString() && newData.val().length <= 30" },
        "$other":    { ".validate": false }
      }
    },

    "appointments": {
      ".read": "auth != null && root.child('admins').child(auth.uid).val() === true",
      ".indexOn": ["start", "paymentStatus"],
      "$id": {
        ".read": "auth != null && data.child('uid').val() === auth.uid",
        ".write": false
      }
    },

    "userAppointments": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": false
      }
    },

    "orphanPayments": {
      ".read": "auth != null && root.child('admins').child(auth.uid).val() === true",
      ".write": false
    },

    "auditLog": {
      ".read": "auth != null && root.child('admins').child(auth.uid).val() === true",
      ".write": false
    }
  }
}
